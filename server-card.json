{
  "name": "a2areplayreceipt",
  "title": "A2A Replay Receipt",
  "description": "A paid remote MCP for A2A failure replay MCP, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://a2areplayreceipt.clauxel.com/",
  "documentationUrl": "https://a2areplayreceipt.clauxel.com/mcp/",
  "endpointUrl": "https://a2areplayreceipt.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://a2areplayreceipt.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://a2areplayreceipt.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://a2areplayreceipt.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 49
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 149
      },
      {
        "id": "platform",
        "name": "Platform",
        "monthlyUsd": 399
      }
    ]
  },
